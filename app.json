{
  "expo": {
    "name": "Bahay",
    "slug": "bahay",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1426",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.junaire.bahay",
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "expo-sharing",
      "expo-status-bar",
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Unlock Bahay with Face ID."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a QR code, receipt or goal photo.",
          "cameraPermission": "Take a photo for a receipt or a goal."
        }
      ]
    ],
    "scheme": "bahay",
    "experiments": {
      "typedRoutes": false
    }
  }
}
